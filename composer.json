{
  "name": "coaching/platform-api",
  "description": "Coaching Platform REST API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "mongodb/mongodb": "^2.2",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "aws/aws-sdk-php": "^3.302",
    "phpoffice/phpspreadsheet": "^2.0",
    "stripe/stripe-php": "^20.2",
    "monolog/monolog": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
