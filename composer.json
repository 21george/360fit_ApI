{
  "name": "coaching/platform-api",
  "description": "Coaching Platform REST API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "mongodb/mongodb": "^2.2",
    "firebase/php-jwt": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "aws/aws-sdk-php": "^3.302",
    "phpoffice/phpspreadsheet": "^2.0",
    "stripe/stripe-php": "^16.0",
    "phpmailer/phpmailer": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  }
}
