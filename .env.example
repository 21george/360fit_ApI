APP_ENV=development
APP_URL=http://localhost:8000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=CoachingPlatform
MONGO_DB=coaching_platform

# JWT — generate with: openssl rand -hex 40 (256-bit / 40-byte hex)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000

# Coach Cap (overridden by subscription tier)
MAX_CLIENTS_PER_COACH=50

# Rate limiting
# Auth endpoints (login, register, verify) — stricter
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=900
# General data endpoints — applied globally in bootstrap/app.php
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=900

# CORS / invite links
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Staff invite URL. Defaults to APP_URL/staff/accept-invite.html. Override this
# if your frontend implements its own staff invite acceptance page.
STAFF_INVITE_URL=http://localhost:3000/staff/accept-invite

# Mail
APP_NAME=CoachPro
MAIL_FROM=noreply@coachpro.app
MAIL_FROM_NAME=CoachPro
MAIL_DOMAIN=coachpro.app

# SMTP (optional — when EMAIL_HOST is set PHPMailer uses SMTP; otherwise falls back to PHP mail())
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_ENCRYPTION=tls
EMAIL_SMTP_AUTH=true

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/subscription/success
STRIPE_CANCEL_URL=http://localhost:3000/subscription/cancel

# Generic fallback price IDs
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly

# Period-specific price IDs (override generics when present)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual

# FCM (v1 API — path to service account JSON)
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=

# Scheduled Notifications (cron job for reminders)
# Run every minute: * * * * * cd /path/to/backend && php scripts/send-reminders.php

# S3 / R2 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-central-1
AWS_ENDPOINT=


# USDA FoodData Central (optional — free tier works without a key, but rate-limited)
USDA_API_KEY=

# Nutrition cache (async caching layer in front of the USDA integration)
NUTRITION_CACHE_DRIVER=mongo
# REDIS_URL=redis://:password@localhost:6379
NUTRITION_CACHE_HOT_TTL_SECONDS=3600
NUTRITION_STALE_GRACE_DAYS=14
NUTRITION_ASYNC_REFRESH_ENABLED=true
NUTRITION_CACHE_REFRESH_INTERVAL_MIN=15
# Run every 15 minutes: */15 * * * * cd /path/to/backend && php scripts/nutrition-cache-refresh.php

# Wearable trend cache (async caching layer over wearable_data aggregates)
WEARABLE_CACHE_DRIVER=mongo
WEARABLE_TREND_CACHE_TTL_SECONDS=900
WEARABLE_TREND_STALE_GRACE_MINUTES=60
WEARABLE_ASYNC_REFRESH_ENABLED=true
WEARABLE_SYNC_WORKER_INTERVAL_MIN=5
# Run every 5 minutes: */5 * * * * cd /path/to/backend && php scripts/wearable-trend-cache-refresh.php

# Shared optional Redis hot layer (never a correctness dependency — falls back
# to Mongo automatically if unset, unreachable, or the phpredis extension is missing)

